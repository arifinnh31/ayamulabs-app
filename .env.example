# ==============================================================================
# AYAMU LABS - DATABASE & SUPABASE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Connect to Supabase via connection pooling with Supavisor / PgBouncer
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations and prisma db push
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Public & Service API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Public Site Domain (Canonical URL for SEO & OpenGraph)
NEXT_PUBLIC_SITE_URL="https://ayamulabs.art"
